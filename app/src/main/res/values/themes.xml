<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg">#FF0A0A0A</color>
    <color name="icon_bg">#FFE50914</color>
    <style name="Theme.TubeRank" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
    </style>
    <!-- Launch splash (logo on black); stays up while the app open ad loads. -->
    <style name="Theme.TubeRank.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.TubeRank</item>
    </style>
</resources>
